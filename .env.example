# Copy to .env and fill in what you have. Never commit .env.

# API keys of the two coding agents. Optional on a dev machine: without a key, an agent uses the login already
# on the machine (Claude Code or Codex signed in). Required when the agents run in a sandbox.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# The model each agent runs on. Defaults: "haiku" and "gpt-6-luna".
CLAUDE_CODE_MODEL=
CODEX_MODEL=

# The model that checks a task is a coding task before the agents run, and reviews afterwards whether each agent
# did it. Its full name, since the API does not know the short ones. Default: "claude-haiku-5-5".
TASK_CHECK_MODEL=

# What runs a task. Default: "sandbox" on Vercel, "local" elsewhere.
#   "local"     the real agents, on this machine
#   "sandbox"   the real agents, each in a Vercel Sandbox: needs both keys above, and a sandbox token in
#               VERCEL_OIDC_TOKEN (Vercel provides it when hosted; elsewhere `vercel env pull` writes one)
#   "recorded"  recordings of real runs: no key, no login, and the same answer whatever the task
AGENT_RUNTIME=

# In a sandbox, the longest a run may take, in seconds. Default: 240.
SANDBOX_RUN_LIMIT_SECONDS=

# The port of the API. Default: 3001.
PORT=

# Read by the web app: where it forwards the API calls of the page. Default: http://localhost:3001.
API_URL=
