# Copy to .env and fill in what you have. Never commit .env.

# API keys of the two coding agents. Optional on a dev machine: without a key, an agent uses the login already
# on the machine (Claude Code or Codex signed in). Required when the agents run in a sandbox.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# The model each agent runs on. Defaults: "haiku" and "gpt-6-luna".
CLAUDE_CODE_MODEL=
CODEX_MODEL=

# The port of the API. Default: 3001.
PORT=

# Where the agents run: "local" (a temp folder on this machine) or "sandbox" (Vercel Sandbox).
# Default: "sandbox" on Vercel, "local" elsewhere.
AGENT_RUNTIME=
