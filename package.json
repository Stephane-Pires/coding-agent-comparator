{
  "name": "coding-agent-comparator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Send one task to two coding agents and compare how each performed.",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "prepare": "vp config --no-agent",
    "dev": "pnpm --parallel --filter @comparator/server --filter @comparator/web dev",
    "storybook": "pnpm --filter @comparator/ui storybook",
    "check": "vp check && vp test run",
    "fix": "vp check --fix",
    "test": "vp test run",
    "eval:task-check": "node apps/server/src/evals/task-check.eval.ts",
    "eval:run-review": "node apps/server/src/evals/run-review.eval.ts",
    "test:e2e": "playwright test -c playwright.e2e.config.ts",
    "test:e2e:film": "E2E_FILM=1 playwright test -c playwright.e2e.config.ts",
    "test:e2e:live": "E2E_RUNTIME=local playwright test -c playwright.e2e.config.ts",
    "test:e2e:sandbox": "E2E_RUNTIME=sandbox playwright test -c playwright.e2e.config.ts",
    "fixtures:record": "node apps/server/src/record.ts",
    "test:stories": "pnpm --filter @comparator/ui build-storybook && playwright test -c playwright.storybook.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite-plus": "^1.7.0"
  }
}
