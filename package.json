{
  "name": "coding-agent-comparator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Send one task to two coding agents and compare how each performed.",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "prepare": "vp config --no-agent",
    "dev": "pnpm --filter @comparator/server dev",
    "storybook": "pnpm --filter @comparator/ui storybook",
    "check": "vp check && vp test run",
    "fix": "vp check --fix",
    "test": "vp test run",
    "test:stories": "pnpm --filter @comparator/ui build-storybook && playwright test -c playwright.storybook.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite-plus": "^1.7.0"
  }
}
